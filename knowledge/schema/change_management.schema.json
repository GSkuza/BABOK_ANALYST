{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://babok-analyst.local/schemas/change_management.schema.json",
  "title": "Change Management Knowledge File",
  "description": "JSON Schema for BABOK Analyst change-management reference files (knowledge/change_management/). A topic with catalogued items (patterns, readiness factors) and/or sourced benchmarks.",
  "type": "object",
  "required": ["topic", "description"],
  "additionalProperties": true,
  "anyOf": [
    { "required": ["items"] },
    { "required": ["benchmarks"] }
  ],
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 10 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "indicators": { "type": "array", "items": { "type": "string" } },
          "response": { "type": "string" }
        }
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "value", "source", "year"],
        "properties": {
          "metric": { "type": "string" },
          "value": { "type": "string" },
          "source": { "type": "string" },
          "year": { "type": "integer" }
        }
      }
    },
    "sources": { "type": "array", "items": { "type": "string" } }
  }
}
