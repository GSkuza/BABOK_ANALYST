{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://babok-analyst.local/schemas/framework.schema.json",
  "title": "Management Framework Knowledge File",
  "description": "JSON Schema for BABOK Analyst framework knowledge files (knowledge/frameworks/). Describes a strategy, diagnostic or change framework as either a set of dimensions (e.g. 7S) or ordered steps (e.g. Kotter, DMAIC).",
  "type": "object",
  "required": ["framework", "description", "best_for"],
  "additionalProperties": true,
  "anyOf": [
    { "required": ["dimensions"] },
    { "required": ["steps"] }
  ],
  "properties": {
    "framework": { "type": "string", "minLength": 1 },
    "origin": { "type": "string", "description": "Author / organisation and year" },
    "description": { "type": "string", "minLength": 10 },
    "best_for": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Engagement situations where this framework is the right diagnostic or design lens"
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "diagnostic_questions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "name", "description"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "outputs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "pitfalls": { "type": "array", "items": { "type": "string" } },
    "applies_to_stages": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "description": "Consulting-profile stages where this framework is typically injected"
    },
    "sources": { "type": "array", "items": { "type": "string" } }
  }
}
